rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Jeder Nutzer hat einen isolierten Datensatz — kein Zugriff auf fremde
    // Profile/Kalender (Abschnitt 3: "keine gemeinsame Tabellensicht").
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /days/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Steuerteil (Issue #10): Belege nur für den Besitzer, siehe Entscheidung in #11.
      match /handwerker/{belegId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /werbungskosten/{belegId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
